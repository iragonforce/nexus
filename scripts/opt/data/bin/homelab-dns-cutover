#!/usr/bin/env bash
# Purpose: Safely add standard DNS port 53 to the existing Nexus CoreDNS pilot,
#          retaining port 1053 for step-ca. Keeps one active Compose file.
# Inputs:  audit | promote | verify | rollback; existing Corefile, Compose,
#          coredns container, dig/ss/docker/curl on Nexus.
# Outputs: Local and Tailscale DNS checks; timestamped rollback snapshot in
#          /var/backups/homelab/network-alias-dns; no DHCP/Tailscale changes.
# Safety:  The script aborts if any port 53 listener is detected, verifies
#          exact known state, and restores Corefile on failed promotion.
set -Eeuo pipefail
umask 077

DIR=/opt/data/network-alias-dns
BACKUP_DIR=/var/backups/homelab/network-alias-dns
CORE="$DIR/Corefile"
COMPOSE="$DIR/compose.yaml"
LAN=192.168.1.2
TS=100.96.255.81
SERVICE=alias-dns-pilot
CONTAINER=coredns
ROOT=/srv/containers/data/step-ca/certs/root_ca.crt
CA=https://192.168.1.2:9000/health
STATE="$BACKUP_DIR/last-corefile-backup"

log() { printf '\n=== %s ===\n' "$*"; }
die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"; }
root_only() { [ "$(id -u)" -eq 0 ] || die 'Use sudo on Nexus'; }
compose() { docker compose -f "$COMPOSE" "$@"; }
preflight() {
  root_only
  for c in docker dig ss python3 curl; do need "$c"; done
  test -f "$CORE" && test -f "$COMPOSE" || die 'Expected Corefile or Compose file missing'
  compose config -q || die 'Compose validation failed'
  [ "$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$CONTAINER")" = host ] || die 'CoreDNS not in host networking'
  [ "$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER")" = unless-stopped ] || die 'CoreDNS restart policy differs from confirmed baseline'
  [ "$(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' "$CONTAINER")" = "$SERVICE" ] || die 'Unexpected Compose service name'
  log 'PORT 53 EXISTING LISTENERS (TCP AND UDP)'
  ss -H -lnut '( sport = :53 )' || true
  log 'DNS PILOT LISTENERS (TCP AND UDP)'
  ss -H -lnut '( sport = :1053 )' || true
  log 'CURRENT COREDNS CONFIGURATION'
  grep -nE '^\.:([0-9]+) \{|^[[:space:]]+(bind|view|hosts|forward) ' "$CORE" || true
  log 'ACTIVE SERVICE'
  compose ps "$SERVICE"
}
check_answer() {
  local ip=$1 port=$2 host=$3 want=$4 got
  got="$(dig +short +time=2 +tries=1 @"$ip" -p "$port" "$host" A | head -n1)"
  printf '%-20s %-7s %-8s -> %-18s\n' "$ip" "$port" "$host" "$got"
  [ "$got" = "$want" ] || die "Expected $host -> $want on $ip:$port, got: $got"
}
verify() {
  preflight >/dev/null
  log 'PRODUCTION DNS, LAN-SOURCE VIEW'
  check_answer "$LAN" 53 nexus 192.168.1.2
  check_answer "$LAN" 53 tensor 192.168.1.3
  local q
  q="$(dig +short +time=2 +tries=1 @"$LAN" -p 53 qubit A | head -n1)"
  case "$q" in 192.168.1.4|100.103.67.56) printf 'qubit -> %s (check presence policy)\n' "$q";; *) die "Invalid qubit answer: $q";; esac
  log 'PRODUCTION DNS, TAILSCALE-SOURCE VIEW'
  check_answer "$TS" 53 nexus 192.168.1.2
  check_answer "$TS" 53 tensor 192.168.1.3
  log 'LEGACY DNS KEPT FOR STEP-CA'
  check_answer "$LAN" 1053 tensor 192.168.1.3
  log 'TCP DNS AND PUBLIC FORWARDING'
  dig +tcp +short +time=2 +tries=1 @"$LAN" -p 53 tensor A | grep -Fx 192.168.1.3 >/dev/null || die 'TCP DNS failed'
  dig +short +time=3 +tries=1 @"$LAN" -p 53 example.com A | grep -Eq '^[0-9]+\.' || die 'External forwarding failed'
  log 'STEP-CA'
  if [ -r "$ROOT" ]; then
    curl -fsS --connect-timeout 4 --max-time 6 --cacert "$ROOT" "$CA"
    printf '\n'
  else
    printf 'Skipping CA test: expected root certificate not present\n'
  fi
  log 'COREDNS STATUS'
  docker inspect -f '{{.Name}} | {{.State.Status}} | restart={{.HostConfig.RestartPolicy.Name}}' "$CONTAINER"
  printf 'PASS: Local port 53 + legacy 1053 tests; remote-client tests are still required.\n'
}
restore_corefile() {
  local src=$1
  [ -r "$src" ] || die "Rollback backup missing: $src"
  cp -a "$src" "$CORE"
  compose up -d --no-deps --force-recreate "$SERVICE"
}
promote() {
  preflight
  if grep -q '^\.:53 {' "$CORE"; then
    printf 'Port 53 already declared. Verifying instead.\n'
    verify
    return
  fi
  local listeners count
  listeners="$(ss -H -lnut '( sport = :53 )' || true)"
  [ -z "$listeners" ] || die 'Port 53 is occupied. Inspect existing listener before changing anything.'
  count="$(grep -c '^\.:1053 {' "$CORE")"
  [ "$count" = 2 ] || die "Expected 2 existing :1053 server blocks; got $count"
  install -d -m 0700 "$BACKUP_DIR"
  local stamp backup
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup="$BACKUP_DIR/Corefile.before-port53.$stamp"
  cp -a "$CORE" "$backup"
  printf '%s\n' "$backup" > "$STATE"
  log "BACKUP: $backup"
  python3 - "$CORE" <<'PY'
import os, pathlib, sys, tempfile
path = pathlib.Path(sys.argv[1]); old = path.read_text()
assert old.count('.:1053 {') == 2 and '.:53 {' not in old, 'Corefile baseline changed'
extra = old.replace('.:1053 {', '.:53 {')
content = old.rstrip() + '\n\n# Standard port 53, mirrored from the verified port 1053 pilot.\n' + extra
fd, temp = tempfile.mkstemp(prefix='.Corefile.', dir=path.parent)
try:
    os.fchmod(fd, path.stat().st_mode & 0o777)
    with os.fdopen(fd, 'w') as stream: stream.write(content)
    os.replace(temp, path)
finally:
    if os.path.exists(temp): os.unlink(temp)
PY
  log 'RECREATE ONLY COREDNS (SHORT DNS INTERRUPTION)'
  if ! compose up -d --no-deps --force-recreate "$SERVICE"; then
    printf 'ERROR: Compose recreate failed. Restoring original Corefile.\n' >&2
    restore_corefile "$backup" || true
    die 'Promotion failed; attempted automatic rollback'
  fi
  sleep 2
  if ! (verify); then
    printf 'ERROR: DNS verification failed. Restoring original Corefile.\n' >&2
    restore_corefile "$backup" || true
    die 'Promotion failed; attempted automatic rollback'
  fi
  printf '\nPROMOTION PASS. Backup: %s\n' "$backup"
  printf 'Next: verify port 53 from Qubit and Tensor, including Qubit on hotspot.\n'
}
rollback() {
  root_only
  [ -f "$STATE" ] || die 'No recorded Corefile backup'
  local backup
  backup="$(cat "$STATE")"
  [ -n "$backup" ] || die 'Empty rollback reference'
  log "RESTORE $backup"
  restore_corefile "$backup"
  log 'CHECK LEGACY DNS'
  check_answer "$LAN" 1053 tensor 192.168.1.3
  printf 'ROLLBACK COMPLETE. Verify local services and CA health.\n'
}
case "${1:-}" in
  audit) preflight ;;
  promote) promote ;;
  verify) verify ;;
  rollback) rollback ;;
  *) printf 'Usage: %s {audit|promote|verify|rollback}\n' "$0" >&2; exit 2 ;;
esac
